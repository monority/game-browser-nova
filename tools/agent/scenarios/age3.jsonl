{"cmd":"tick","n":20}
# --- the milestone that needs planks ---
{"cmd":"build","type":"market","x":21,"y":3,"road":false}
# --- the exact-balance package, bought in one batch so construction overlaps:
#     2 farms (food = 22), 4 residences (pop 20), 2 wells (water = 20) ---
{"cmd":"build","type":"farm","x":2,"y":3}
{"cmd":"build","type":"farm","x":4,"y":3}
{"cmd":"build","type":"residence","x":0,"y":3,"road":false}
{"cmd":"build","type":"residence","x":1,"y":3,"road":false}
{"cmd":"build","type":"residence","x":6,"y":3,"road":false}
{"cmd":"build","type":"residence","x":10,"y":3,"road":false}
{"cmd":"build","type":"well","x":13,"y":3}
{"cmd":"build","type":"well","x":16,"y":3}
{"cmd":"tick","n":120}
{"cmd":"assess"}
# --- tech5: wheelbarrow, not irrigation (see 5. above) ---
{"cmd":"do","command":{"kind":"researchTech","techId":"deepMining"}}
{"cmd":"do","command":{"kind":"researchTech","techId":"wheelbarrow"}}
{"cmd":"tick","n":60}
{"cmd":"assess"}
{"cmd":"report"}

