# Age 3 from the completed age-2 line (Step063 play session, re-anchored Step065).
#
# This file is exactly age2.jsonl (its header explains the age-1 arc and the
# four-dimension age-2 set; the market removal is Step065) plus the push to the
# Age of Prosperity.
#
# The age-3 milestone set is pop 20, treasury 1500, 30 operational buildings,
# 20 residences and 3 workshops. At t=780 the line has pop 16, 16 residences,
# 34 buildings, 2 workshops and 787 money (+5/tick), and it is an EXACT
# balance: 5 farms (3 each, cropRotation) + the anchor's 1 = 16 food for 16
# mouths, 8 wells = 16 water, 15 workplaces = 15 workers, pollution 0 with 2
# parks against 2 workshops. Measured decisions for this push:
#   1. There is no market any more, so the colony cannot sell a surplus: the
#      growth target is the next EXACT balance, pop 22 = 7 farms (7*3 + 1)
#      = 11 wells (2 each) = 22. A 24-colonist line would produce 24 and eat
#      23, pin the granary at 120/120 and destroy the surplus (measured before
#      this re-anchor; the storage line is information, never a warning).
#   2. A workshop pays its keep unstaffed: commerce is staffing-independent
#      (2 + 1 per tradeRoutes), so a third workshop adds +3/tick for 1 upkeep.
#      It is the cheapest revenue, and at 21 workplaces for 22 colonists it
#      is in fact staffed here.
#   3. Residences are upkeep-exempt (Step021): the 6 new ones raise housing to
#      22 and cost nothing per tick.
# Measured: HEALTHY at t=1140 with pop 22/22, money 3319 (net +8/tick), 46
# buildings, food and water at +0/tick, 21 jobs for 22 colonists, pollution 0
# (2 parks against 3 staffed workshops, net -1); every age-2 milestone done,
# advanceAge then opens Age 3 (t=1141, money 3327, verdict HEALTHY) with its
# own set already satisfied. The old line banked more (2441) because the market
# turned 2 food/tick into money; the treasury is now pure tax + commerce,
# which is why the push waits longer before the 1500 threshold.
{"cmd":"init"}
{"cmd":"tick","n":120}
{"cmd":"do","command":{"kind":"researchTech","techId":"cropRotation"}}
{"cmd":"build","type":"park","x":11,"y":1}
{"cmd":"build","type":"park","x":15,"y":1}
{"cmd":"tick","n":300}
{"cmd":"report"}
{"cmd":"do","command":{"kind":"placeRoads","cells":["19,2","21,2"]}}
{"cmd":"build","type":"well","x":18,"y":2,"road":false}
{"cmd":"build","type":"well","x":20,"y":2,"road":false}
{"cmd":"build","type":"well","x":22,"y":2,"road":false}
{"cmd":"build","type":"residence","x":13,"y":1,"road":false}
{"cmd":"build","type":"residence","x":17,"y":1,"road":false}
{"cmd":"build","type":"residence","x":19,"y":1,"road":false}
{"cmd":"build","type":"residence","x":21,"y":1,"road":false}
{"cmd":"tick","n":60}
{"cmd":"report"}
{"cmd":"build","type":"residence","x":23,"y":1,"road":false}
{"cmd":"build","type":"residence","x":12,"y":2,"road":false}
{"cmd":"tick","n":60}
{"cmd":"assess"}
{"cmd":"tick","n":120}
{"cmd":"assess"}
# --- age-1 milestones close, age 2 opens (four dimensions, no market) ---
{"cmd":"do","command":{"kind":"researchTech","techId":"masonry"}}
{"cmd":"do","command":{"kind":"researchTech","techId":"tradeRoutes"}}
{"cmd":"do","command":{"kind":"advanceAge"}}
# --- tech5: the two age-2 techs ---
{"cmd":"do","command":{"kind":"researchTech","techId":"deepMining"}}
{"cmd":"do","command":{"kind":"researchTech","techId":"wheelbarrow"}}
{"cmd":"tick","n":120}
{"cmd":"assess"}
# --- growth to the next exact balance: pop 22 = 7 farms = 11 wells, 22
#     residences, a third workshop for revenue (see 1-3 above) ---
{"cmd":"build","type":"farm","x":2,"y":5}
{"cmd":"build","type":"farm","x":4,"y":5}
{"cmd":"build","type":"well","x":6,"y":5}
{"cmd":"build","type":"well","x":8,"y":5}
{"cmd":"build","type":"well","x":10,"y":5}
{"cmd":"build","type":"workshop","x":8,"y":4}
{"cmd":"build","type":"residence","x":12,"y":4,"road":false}
{"cmd":"build","type":"residence","x":14,"y":4,"road":false}
{"cmd":"build","type":"residence","x":16,"y":4,"road":false}
{"cmd":"build","type":"residence","x":18,"y":4,"road":false}
{"cmd":"build","type":"residence","x":20,"y":4,"road":false}
{"cmd":"build","type":"residence","x":22,"y":4,"road":false}
{"cmd":"tick","n":120}
{"cmd":"assess"}
{"cmd":"report"}
{"cmd":"tick","n":240}
{"cmd":"assess"}
{"cmd":"report"}
# --- all age-2 milestones done: open the Age of Prosperity ---
{"cmd":"do","command":{"kind":"advanceAge"}}
{"cmd":"tick","n":1}
{"cmd":"assess"}
